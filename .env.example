# UDESC Simulados cloud configuration (Render or Google Cloud Run).
# Neon PostgreSQL pooled connection for ordinary requests.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Neon direct connection for SQL migrations and legacy data claims.
DATABASE_MIGRATION_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 private bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=udesc-simulados
# R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Authentication uses registered user accounts (email + password) in NeonDB.
# Sessions remain valid for 30 days. Always true on HTTPS production hosting.
SESSION_COOKIE_SECURE=true
# Maximum PDF upload size in MiB.
MAX_PDF_MB=35
